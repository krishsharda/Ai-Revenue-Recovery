# ============================================================================
# AI Revenue Recovery — environment configuration
#
# Local development: copy this file to `.env` in the repo root; the backend
# reads it automatically. EVERYTHING here is optional — with no values set the
# app runs fully self-contained (SQLite + simulated Razorpay + heuristic AI).
#
# Vercel: set these as Environment Variables on the project instead. Only
# DATABASE_URL is genuinely required there, because a serverless filesystem
# cannot persist SQLite between requests.
#
# NEVER commit your real .env file.
# ============================================================================

# ---- Database ---------------------------------------------------------------
# Local default is a SQLite file. In deployment, point this at Postgres — Neon,
# Supabase and Vercel Postgres all work. Use the POOLED connection string
# (Neon calls it "-pooler"): serverless functions open many short-lived
# connections and will exhaust a direct Postgres endpoint.
#
# The `postgres://` and `postgresql://` forms these providers hand out are
# rewritten to `postgresql+psycopg://` automatically.
#
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./ai_revenue_recovery.db

# ---- Admin authentication ---------------------------------------------------
# Protects the one endpoint that spends real money and sender reputation:
#   POST /api/settings/email/test
# Send it as the `X-Admin-Token` request header. The browser is never given the
# token, so on a deployment the Settings page reports the test send as
# unavailable instead of offering a button that can only 401 — use curl.
# REQUIRED on any public deployment: with it unset, that endpoint fails closed
# rather than becoming an anonymous mail relay. Locally it stays open so
# development needs no setup.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---- Razorpay (TEST MODE ONLY) ---------------------------------------------
# Get these from the Razorpay Dashboard in Test Mode. When present, the app
# makes real Razorpay Test API calls (orders, payment links) and verifies
# webhook signatures. When absent, those actions are clearly labelled SIMULATED.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- LLM decision engine (optional) ----------------------------------------
# When set, the LLM proposes recovery decisions (validated against a strict
# schema, then the guardrail engine). When unset, a deterministic heuristic
# engine is used instead. The ML recovery-probability stays authoritative.
# Provider is auto-detected from the key prefix; override with LLM_PROVIDER.
LLM_API_KEY=
LLM_MODEL=
# LLM_PROVIDER=anthropic     # auto | anthropic | openai

# ---- Email recovery (Resend — REAL transactional email) --------------------
# When both are set, EMAIL recovery actions send a REAL email via Resend.
# When unset, EMAIL actions are BLOCKED (never faked). Get a key at resend.com.
# EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ---- Guardrail policy engine (safe defaults) -------------------------------
MAX_PAYMENT_RETRIES=2
MAX_CUSTOMER_MESSAGES=2
RECOVERY_WINDOW_HOURS=24
MIN_RECOVERY_PROBABILITY=0.15

# ---- CORS -------------------------------------------------------------------
# Only needed if the frontend is served from a different origin than the API.
# On Vercel both are one deployment behind one domain, so this can stay as-is.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# Frontend (frontend/.env.local — local development only)
#
#   BACKEND_ORIGIN=http://127.0.0.1:8000
#
# Next proxies /api there in development. In production Vercel routes /api to
# the API service (see vercel.json), so this is not set on Vercel.
# ============================================================================
